#include <windows.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_GOTO DIALOGEX 0, 0, 200, 62
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go to line"
FONT 9, "MS Shell Dlg 2", 400, 0, 1
BEGIN
    LTEXT           "Line number (1 - 1):", IDC_GOTO_LABEL, 7, 7, 186, 9
    EDITTEXT        IDC_GOTO_EDIT, 7, 19, 186, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 89, 41, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 41, 50, 14
END

// Settings window skeleton (not reachable unless enable_config_dialog=true).
IDD_CONFIG DIALOGEX 0, 0, 320, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "tcl-syntaxhl settings"
FONT 9, "MS Shell Dlg 2", 400, 0, 1
BEGIN
    CONTROL         "", IDC_CONFIG_TABS, "SysTabControl32", WS_TABSTOP, 7, 7, 306, 160
    LTEXT           "Settings UI is not implemented yet. Edit the INI file directly:",
                    IDC_CONFIG_PLACEHOLDER, 17, 30, 286, 9
    EDITTEXT        IDC_CONFIG_PATH, 17, 44, 286, 13, ES_AUTOHSCROLL | ES_READONLY
    DEFPUSHBUTTON   "OK", IDOK, 209, 179, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 263, 179, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TCL_VER_MAJOR,TCL_VER_MINOR,TCL_VER_PATCH,0
 PRODUCTVERSION TCL_VER_MAJOR,TCL_VER_MINOR,TCL_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Total Commander Lister syntax highlighting plugin"
            VALUE "FileVersion", TCL_VER_STRING
            VALUE "InternalName", "tcl-syntaxhl"
            VALUE "OriginalFilename", "tcl-syntaxhl.wlx64"
            VALUE "ProductName", "tcl-syntaxhl"
            VALUE "ProductVersion", TCL_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
