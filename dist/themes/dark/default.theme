; Dark theme - base palette for all languages.
; [Tokens] format: class=foreground[,background][,flags]   or   class=@otherclass
;   colors: #RRGGBB (or #RGB); empty field = keep the inherited value
;   background: "none" = view background
;   flags : bold, italic, underline (combine with +), or normal (= none).
;           When given, flags REPLACE the inherited ones; when the field is
;           omitted the inherited flags stay (e.g. "comment=#008000" stays italic).
;   @otherclass: look exactly like another class (e.g. section_bracket=@section)
; Unknown class names are ignored. Per-language files (python.theme, ini.theme,
; ...) only need overrides. Italic comments can also be switched off globally
; with italic_comments=false in tcl-syntaxhl.ini.

[View]
background=#1E1E1E
foreground=#D4D4D4
infobar_background=#3C3C00
infobar_foreground=#F0F0F0

[Tokens]
keyword=#569CD6
builtin=#4EC9B0
constant=#569CD6
identifier=#D4D4D4
function=#DCDCAA
type=#4EC9B0
decorator=#C586C0
number=#B5CEA8
string=#CE9178
string_escape=#D7BA7D
comment=#6A9955,,italic
operator=#D4D4D4
punctuation=#D4D4D4
key=#9CDCFE
section=#569CD6,,bold
value=#CE9178
